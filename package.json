{
  "name": "soft-frosted-icons",
  "version": "1.0.0",
  "description": "136 frosted glass SVG icons in two finishes, outline and duo-tone, on one 48px grid. Web component, SVG strings, React wrapper and plain SVG files. No dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./define": { "types": "./src/define.d.ts", "default": "./src/define.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" },
    "./tokens.css": "./tokens.css",
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "svg/outline/*.svg", "svg/duo/*.svg", "tokens.css", "LICENSE"],
  "sideEffects": ["./src/define.js", "*.css"],
  "scripts": {
    "build": "node tools/build-svg.js",
    "check": "node tools/check.js",
    "prepublishOnly": "node tools/check.js"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "license": "MIT",
  "author": "Dev-Muhammad-Junaid",
  "homepage": "https://dev-muhammad-junaid.github.io/soft-frosted-icons/",
  "repository": { "type": "git", "url": "git+https://github.com/Dev-Muhammad-Junaid/soft-frosted-icons.git" },
  "bugs": { "url": "https://github.com/Dev-Muhammad-Junaid/soft-frosted-icons/issues" },
  "keywords": ["icons", "svg", "icon-set", "frosted", "glass", "glassmorphism", "duotone", "web-component", "custom-element", "react", "soft-ui"]
}
